{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellFerry",
  "version": "0.8.0",
  "identifier": "io.github.rzkfyn.shellferry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShellFerry",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_SHELLFERRY_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/rzkfyn/openterm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
