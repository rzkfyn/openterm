{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Default capability for the main desktop window",
  "identifier": "default",
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "dialog:default"
  ],
  "windows": ["main"]
}
